{
  "name": "21st-ark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @21st-ark/frontend\" \"npm run dev -w @21st-ark/backend\"",
    "dev:frontend": "npm run dev -w @21st-ark/frontend",
    "dev:backend": "npm run dev -w @21st-ark/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build -w @21st-ark/frontend",
    "build:backend": "npm run build -w @21st-ark/backend",
    "check": "npm run check --workspaces",
    "test:render": "node scripts/check-render.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test:adfit": "node scripts/test-adfit.mjs",
    "test:public-profiles": "npm run build:backend && node scripts/test-public-profiles.mjs && node scripts/test-public-profiles-ui.mjs",
    "test:profile-media": "npm run build:backend && node scripts/test-profile-media.mjs",
    "test:mcp": "npm run build:backend && node scripts/test-mcp.mjs && node scripts/test-mcp-ui.mjs",
    "test:auth": "npm run build:backend && node --experimental-strip-types scripts/test-auth.mjs",
    "test:features": "npm run build:backend && node scripts/test-features.mjs",
    "db:check": "npm run db:check -w @21st-ark/backend",
    "db:migrate:local": "npm run db:migrate:local -w @21st-ark/backend",
    "deploy:frontend": "npm run deploy -w @21st-ark/frontend",
    "deploy:backend": "npm run deploy -w @21st-ark/backend",
    "test:github": "npm run build:backend && node scripts/test-github.mjs",
    "test:taxonomy": "npm run build:backend && node scripts/test-taxonomy.mjs",
    "test:comments": "npm run build:backend && node scripts/test-comments.mjs",
    "test:applications": "npm run build:backend && node scripts/test-applications.mjs",
    "test:account-controls": "npm run build:backend && node scripts/test-account-controls.mjs",
    "test:embeds": "node scripts/test-embeds.mjs",
    "test:seo-usernames": "npm run build:backend && node scripts/test-seo-usernames.mjs",
    "test:notices-history": "npm run build:backend && node scripts/test-notices-history.mjs",
    "test:security-performance": "npm run build:backend && node scripts/test-security-performance.mjs && node scripts/test-reader-cache.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1"
  }
}
