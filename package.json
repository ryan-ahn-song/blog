{
  "name": "21st-ark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/frontend", "apps/backend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @21st-ark/frontend\" \"npm run dev -w @21st-ark/backend\"",
    "dev:frontend": "npm run dev -w @21st-ark/frontend",
    "dev:backend": "npm run dev -w @21st-ark/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build -w @21st-ark/frontend",
    "build:backend": "npm run build -w @21st-ark/backend",
    "check": "npm run check --workspaces",
    "test:render": "node scripts/check-render.mjs",
    "test:auth": "npm run build:backend && node --experimental-strip-types scripts/test-auth.mjs",
    "db:check": "npm run db:check -w @21st-ark/backend",
    "db:migrate:local": "npm run db:migrate:local -w @21st-ark/backend",
    "auth:create-user": "node --experimental-strip-types scripts/create-user.mjs",
    "deploy:frontend": "npm run deploy -w @21st-ark/frontend",
    "deploy:backend": "npm run deploy -w @21st-ark/backend"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
