{
  "name": "@21st-ark/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "deploy": "node ../../scripts/deploy-backend.mjs",
    "db:check": "wrangler d1 execute DB --local --command \"SELECT 1 AS connected\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  }
}
