{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "21st-ark-web",
  "main": "worker.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "21st-ark.dev",
      "custom_domain": true
    },
    {
      "pattern": "21stark.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "API",
      "service": "21st-ark-api"
    }
  ],
  "preview_urls": false
}
