{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "21st-ark-web", "main": "worker.ts", "compatibility_date": "2026-11-10",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "services": [{ "binding": "API", "service": "21st-ark-api" }]
}
